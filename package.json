{
  "name": "touchx-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:microapp": "pnpm --filter @touchx/microapp dev:mp-weixin",
    "dev:miniapp": "pnpm --filter @touchx/miniapp dev:weapp",
    "dev:mobile": "pnpm --filter @touchx/mobile start",
    "dev:backend": "pnpm --filter @touchx/backend dev",
    "build:microapp": "pnpm --filter @touchx/microapp build:mp-weixin",
    "build:miniapp": "pnpm --filter @touchx/miniapp build:weapp",
    "build:backend": "pnpm --filter @touchx/backend build",
    "preview:backend": "pnpm --filter @touchx/backend preview",
    "deploy:backend": "pnpm --filter @touchx/backend run deploy",
    "verify:v1-release": "pnpm --filter @touchx/backend verify:v1-local && pnpm --filter @touchx/miniapp build:weapp",
    "type-check": "pnpm -r --if-present type-check"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
