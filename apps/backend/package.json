{
  "name": "@touchx/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./internal/nuxt-paths.mjs"
  },
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "build": "nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "preview": "nuxt preview --host=0.0.0.0 --port=9986",
    "deploy": "nuxt build && wrangler --cwd .output deploy --domains schedule-backend.tagzxia.com --keep-vars",
    "type-check": "nuxt prepare && tsc -p .nuxt/tsconfig.json --noEmit",
    "verify:v1-local": "bash ./scripts/verify-v1-local.sh",
    "verify:v1-production": "bash ./scripts/verify-v1-production.sh",
    "smoke:local": "bash ./scripts/smoke-local.sh",
    "smoke:api-boundaries": "node ./scripts/smoke-api-boundaries.mjs",
    "smoke:admin-ui-boundaries": "node ./scripts/smoke-admin-ui-boundaries.mjs",
    "smoke:client-boundaries": "node ./scripts/smoke-client-boundaries.mjs",
    "smoke:data-boundaries": "node ./scripts/smoke-data-boundaries.mjs",
    "smoke:cloudflare-config": "node ./scripts/smoke-cloudflare-config.mjs",
    "smoke:cloudflare-live": "node ./scripts/smoke-cloudflare-live.mjs",
    "smoke:production": "bash ./scripts/smoke-production.sh",
    "sync:legacy": "node ./scripts/sync-legacy-normalized.mjs"
  },
  "dependencies": {
    "@touchx/shared": "workspace:*",
    "@touchx/calendar-core": "workspace:*",
    "@touchx/api-client": "workspace:*",
    "@touchx/notification-core": "workspace:*",
    "@touchx/import-core": "workspace:*",
    "@touchx/ui-tokens": "workspace:*",
    "ufo": "^1.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^3.17.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.7.0"
  }
}
