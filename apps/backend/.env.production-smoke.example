# Copy this file to apps/backend/.env.production-smoke.local and fill real values there.
# Do not commit the .local copy; apps/backend/.env.* is ignored except checked-in examples.
# After filling it, export the local values before running checks:
# set -a; source apps/backend/.env.production-smoke.local; set +a
# Then run this local precheck; it rejects unreplaced placeholders:
# pnpm --filter @touchx/backend check:v1-production-env
# Then run the full gate:
# pnpm --filter @touchx/backend verify:v1-production

# Public HTTPS production API. Non-global IP literals, single-label/invalid DNS/reserved hostnames, local/private/link-local/CGNAT and non-HTTPS URLs are refused.
TOUCHX_SMOKE_BASE_URL=https://schedule-backend.tagzxia.com

# Optional direct smoke assertion for production bootstrap admin account/student; keep empty unless checking a known value. Do not include whitespace or a placeholder value.
TOUCHX_SMOKE_EXPECT_BOOTSTRAP_STUDENT_NO=

# Raw admin token for protected production checks; do not include the auth scheme prefix, whitespace, or dummy/example/test token value.
TOUCHX_SMOKE_AUTH_TOKEN=__REPLACE_WITH_PRODUCTION_ADMIN_TOKEN__

# Real 6-32 digit production student number used for legacy login verification.
TOUCHX_SMOKE_STUDENT_NO=__REPLACE_WITH_6_TO_32_DIGIT_STUDENT_NO__

# Real ClawDBot webhook token used for inbound webhook smoke; do not include whitespace or dummy/example/test secret value.
TOUCHX_SMOKE_CLAWDBOT_WEBHOOK_TOKEN=__REPLACE_WITH_CLAWDBOT_WEBHOOK_TOKEN__

# Optional ClawDBot webhook smoke text; keep empty to use the default. If set, do not use a placeholder or blank value.
TOUCHX_SMOKE_CLAWDBOT_WEBHOOK_TEXT=

# Full production gate requires both channels.
TOUCHX_SMOKE_NOTIFICATION_CHANNELS=wechat_clawdbot,feishu
# Legacy single-channel direct smoke variable; keep empty for verify:v1-production, do not set together with TOUCHX_SMOKE_NOTIFICATION_CHANNELS, and use TOUCHX_SMOKE_NOTIFICATION_CHANNELS for multiple channels.
TOUCHX_SMOKE_NOTIFICATION_CHANNEL=

# Optional external notification smoke message; keep empty to use the defaults. If set, do not use placeholder or blank values.
TOUCHX_SMOKE_NOTIFICATION_TITLE=
TOUCHX_SMOKE_NOTIFICATION_BODY=

# Local backend URL used only by the real PDF import smoke.
SMOKE_BASE_URL=http://127.0.0.1:9986

# Local PDF import smoke student number; must be 6-32 digits and match TOUCHX_SMOKE_STUDENT_NO.
SMOKE_SCHEDULE_IMPORT_STUDENT_NO=__REPLACE_WITH_6_TO_32_DIGIT_STUDENT_NO__

# Absolute path to a real schedule PDF on this machine; the file must start with a PDF header.
SMOKE_REAL_PDF_PATH=/absolute/path/real-schedule.pdf

# Production gate requires at least 8 parsed entries.
SMOKE_REAL_PDF_MIN_ENTRIES=8

# Optional; defaults to TOUCHX_SMOKE_STUDENT_NO when unset and must match TOUCHX_SMOKE_STUDENT_NO and SMOKE_SCHEDULE_IMPORT_STUDENT_NO.
SMOKE_REAL_PDF_EXPECT_STUDENT_NO=

# Optional destructive check: leave empty or set to 1 only when the supplied admin token may be revoked.
TOUCHX_SMOKE_AUTH_LOGOUT=

# Optional extra weak fallback admin password candidate for smoke:production; keep empty unless auditing a known historical password. If set, do not use a placeholder or blank value.
TOUCHX_SMOKE_FALLBACK_ADMIN_PASSWORD=

# Session-secret bypass must stay empty for verify:v1-production.
TOUCHX_SMOKE_SKIP_SESSION_SECRET_CHECK=

# Direct smoke opt-in flags are set by verify:v1-production; leave them empty here unless running smoke:production directly.
TOUCHX_SMOKE_EXTERNAL_DELIVERY=
TOUCHX_SMOKE_CLAWDBOT_WEBHOOK=
TOUCHX_SMOKE_NOTIFICATION_QUEUE_MODE=
